data/raw/
data/processed/
*.csv
!data/samples/*.csv
*.json
!data/samples/*.json
*.xml
!data/samples/*.xml

# Reports and binary exports
*.pdf
*.mp4
*.docx
*.pptx
*.xlsx

# Build artifacts
build/
dist/
*.egg-info/
